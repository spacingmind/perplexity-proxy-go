{
  "base_url": "https://www.perplexity.ai",
  "api_version": "2.18",
  "session_cookie_name": "__Secure-next-auth.session-token",
  "endpoints": {
    "ask": "/rest/sse/perplexity_ask",
    "search_init": "/search/new",
    "upload": "/rest/uploads/batch_create_upload_urls",
    "rate_limits": "/rest/rate-limit/all",
    "user_settings": "/rest/user/settings",
    "list_threads": "/rest/thread/list_ask_threads",
    "thread_detail": "/rest/thread",
    "credits": "/rest/billing/credits",
    "auth_csrf": "/api/auth/csrf",
    "auth_otp_redirect": "/api/auth/otp-redirect-link",
    "auth_signin_email": "/api/auth/signin/email",
    "auth_totp_verify": "/api/auth/totp-challenge/verify"
  },
  "headers": {
    "x-app-apiclient": "default",
    "accept": "text/event-stream, application/json",
    "content_type": "application/json"
  },
  "defaults": {
    "prompt_source": "user",
    "send_back_text_in_streaming_api": true,
    "use_schematized_api": false,
    "language": "en-US",
    "source_focus": "web",
    "search_focus": "internet",
    "search_recency_filter": "",
    "save_to_library": false,
    "model": "best"
  },
  "models": [
    {
      "name": "experimental",
      "identifier": "experimental",
      "mode": "concise"
    },
